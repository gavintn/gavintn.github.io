<section id="fusion">
  <h2>sensor fusion</h2>
  <p class="dim">
    two noisy sensors measure the same signal. the accent line fuses them, weighting each by 1 / its noise variance.
    the noise levels are known here. a real system has to estimate them.
  </p>

  <label for="na">sensor a noise <span id="na-v">0.60</span></label>
  <input id="na" type="range" min="0.05" max="1.5" step="0.05" value="0.6" />
  <label for="nb">sensor b noise <span id="nb-v">0.20</span></label>
  <input id="nb" type="range" min="0.05" max="1.5" step="0.05" value="0.2" />

  <canvas id="fz" width="640" height="240" aria-label="chart of a true signal, two noisy sensors and the fused estimate"></canvas>

  <ul class="rows fusion-out">
    <li><span>error a</span><span class="dim" id="ea"></span></li>
    <li><span>error b</span><span class="dim" id="eb"></span></li>
    <li><span>error fused</span><span class="dim" id="ef"></span></li>
  </ul>
</section>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const naEl = $('na') as HTMLInputElement;
  const nbEl = $('nb') as HTMLInputElement;
  const canvas = $('fz') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const css = getComputedStyle(document.documentElement);
  const accent = css.getPropertyValue('--accent').trim() || '#7aa2ff';
  const dim = css.getPropertyValue('--dim').trim() || '#888';
  const fg = css.getPropertyValue('--fg').trim() || '#fff';

  const N = 160;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let truth: number[] = [], a: number[] = [], b: number[] = [], f: number[] = [];
  let t = 0, ea2 = 0, eb2 = 0, ef2 = 0;

  const gauss = () =>
    Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(2 * Math.PI * Math.random());

  function step() {
    const na = Number(naEl.value), nb = Number(nbEl.value);
    const v = Math.sin(t * 0.05) + 0.5 * Math.sin(t * 0.013);
    const sa = v + gauss() * na, sb = v + gauss() * nb;
    const wa = 1 / (na * na), wb = 1 / (nb * nb);
    const fused = (sa * wa + sb * wb) / (wa + wb);
    truth.push(v); a.push(sa); b.push(sb); f.push(fused);
    if (truth.length > N) { truth.shift(); a.shift(); b.shift(); f.shift(); }
    ea2 = 0.98 * ea2 + 0.02 * (sa - v) ** 2;
    eb2 = 0.98 * eb2 + 0.02 * (sb - v) ** 2;
    ef2 = 0.98 * ef2 + 0.02 * (fused - v) ** 2;
    t++;
  }

  const X = (i: number) => (i / (N - 1)) * canvas.width;
  const Y = (v: number) => canvas.height / 2 - v * 30;

  function line(arr: number[], color: string, width: number) {
    ctx.strokeStyle = color; ctx.lineWidth = width; ctx.beginPath();
    arr.forEach((v, i) => (i ? ctx.lineTo(X(i), Y(v)) : ctx.moveTo(X(i), Y(v))));
    ctx.stroke();
  }
  function dots(arr: number[], color: string) {
    ctx.fillStyle = color;
    arr.forEach((v, i) => ctx.fillRect(X(i) - 1.5, Y(v) - 1.5, 3, 3));
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    line(truth, dim, 1);
    ctx.globalAlpha = 0.6; dots(a, fg); dots(b, dim); ctx.globalAlpha = 1;
    line(f, accent, 2);
    $('na-v').textContent = Number(naEl.value).toFixed(2);
    $('nb-v').textContent = Number(nbEl.value).toFixed(2);
    $('ea').textContent = Math.sqrt(ea2).toFixed(2);
    $('eb').textContent = Math.sqrt(eb2).toFixed(2);
    $('ef').textContent = Math.sqrt(ef2).toFixed(2);
  }

  function reset() {
    truth = []; a = []; b = []; f = []; t = 0; ea2 = eb2 = ef2 = 0;
    for (let i = 0; i < N + 100; i++) step();
    draw();
  }

  if (reduced) {
    reset();
    naEl.addEventListener('input', reset);
    nbEl.addEventListener('input', reset);
  } else {
    reset();
    setInterval(() => { step(); draw(); }, 50);
  }
</script>