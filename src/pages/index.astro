---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const entries = (await getCollection('log'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="gavintn">
  <header>
    <nav>
      <a href="/">home</a>
      <a href="/log">log</a>
    </nav>
  </header>

  <main>
    <h1>gavintn</h1>
    <p class="role">cs student exploring hardware, ai infrastructure and software</p>

    <section>
      <h2>projects</h2>
      <ol class="rows">
        {projects.map((p) => (
          <li>
            <span>{String(p.data.order).padStart(2, '0')}</span>
            <span>{p.data.title}</span>
            <span class="status">{p.data.status}</span>
            <span class="dim">{p.data.blurb}</span>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>log</h2>
      {entries.length === 0 ? (
        <p class="dim">first entries coming soon.</p>
      ) : (
        <ul class="rows">
          {entries.map((e) => (
            <li>
              <span class="dim">{e.data.date.toISOString().slice(0, 10)}</span>
              <a href={`/log/${e.id}`}>{e.data.title}</a>
              <span class="dim">{e.data.type}</span>
            </li>
          ))}
        </ul>
      )}
      <p><a href="/log">all entries</a></p>
    </section>
  </main>

  <footer>
    <a href="https://github.com/gavintn">github</a>
    <span class="dim">type set in ia writer mono</span>
  </footer>
</Base>
