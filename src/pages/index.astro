---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import skills from '../data/skills.json';

const groups = [
  { key: 'know', title: 'know' },
  { key: 'assisted', title: 'set up with ai help' },
  { key: 'learning', title: 'learning now' },
];

const entries = (await getCollection('log'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="gavintn: networking, homelab, learning to code">
  <main>
    <h1>gavintn</h1>
    <p class="role">student exploring hardware, ai infrastructure, networking, and software</p>

    <section>
      <h2>projects</h2>
      <ol class="rows">
        {projects.map((p) => (
          <li>
            <span>{String(p.data.order).padStart(2, '0')}</span>
            <a href={`/projects/${p.id}`}>{p.data.title}</a>
            <span class="status">{p.data.status}</span>
            <span class="dim">{p.data.blurb}</span>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>lab</h2>
      <p class="dim">small interactive toys: a subnet visualizer, a metrics stream and a sensor-fusion demo.</p>
      <p><a href="/lab">open the lab</a></p>
    </section>

    <section>
      <h2>skills</h2>
      {groups.map((g) => (
        <div>
          <h3>{g.title}</h3>
          <ul class="rows skills">
            {skills.filter((s) => s.group === g.key).map((s) => (
              <li>
                <span>{s.name}</span>
                <span class="dim">{s.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2>log</h2>
      {entries.length === 0 ? (
        <p class="dim">first entries coming soon.</p>
      ) : (
        <ul class="rows">
          {entries.map((e) => (
            <li>
              <span class="dim">{e.data.date.toISOString().slice(0, 10)}</span>
              <a href={`/log/${e.id}`}>{e.data.title}</a>
              <span class="dim">{e.data.type}</span>
            </li>
          ))}
        </ul>
      )}
      <p><a href="/log">all entries</a></p>
    </section>
  </main>

  <footer>
    <a href="https://github.com/gavintn">github</a>
    <span class="dim">type set in ia writer mono</span>
  </footer>
</Base>
