---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('log')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="log: gavintn">
  <h1>log</h1>
  {entries.length === 0 ? (
    <p class="dim">first entries coming soon.</p>
  ) : (
    <ul class="rows log-rows">
      {entries.map((e) => (
        <li>
          <span class="dim">{e.data.date.toISOString().slice(0, 10)}</span>
          <a href={`/log/${e.id}`}>{e.data.title}</a>
          <span class="status">{e.data.type}</span>
        </li>
      ))}
    </ul>
  )}
</Base>