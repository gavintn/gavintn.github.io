---
import '@fontsource/ia-writer-mono';
import '@fontsource/ia-writer-mono/700.css';
import '../styles/global.css';

const {
  title,
  description = 'student exploring hardware, ai infrastructure, networking, and software. projects, skills and a log of what i am learning.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191919" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="gavintn" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <header>
      <nav>
        <a href="/">home</a>
        <a href="/log">log</a>
        <a href="/projects">projects</a>
        <a href="/lab">lab</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <a href="https://github.com/gavintn">github</a>
      <a href="mailto:gavintn@outlook.com">email</a>
      <span class="dim">type set in ia writer mono</span>
    </footer>
  </body>
</html>
